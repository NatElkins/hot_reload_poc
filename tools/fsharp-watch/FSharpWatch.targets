<Project>
  <Import Project="$(FSHARP_WATCH_ORIGINAL_COMMON_TARGETS)"
          Condition="'$(FSHARP_WATCH_ORIGINAL_COMMON_TARGETS)' != '' and Exists('$(FSHARP_WATCH_ORIGINAL_COMMON_TARGETS)')" />
  <ItemGroup Condition="'$(MSBuildProjectExtension)' == '.fsproj' and '$(SupportsHotReload)' != 'false' and '$(FSHARP_WATCH_ENABLE_HOT_RELOAD)' == 'true'">
    <ProjectCapability Include="SupportsHotReload" />
  </ItemGroup>
  <!-- A late target preserves project flags and gives disk baselines and session compiles the same lowering. -->
  <Target Name="FSharpWatchPrepareCompile" BeforeTargets="CoreCompile" Condition="'$(MSBuildProjectExtension)' == '.fsproj' and '$(FSHARP_WATCH_ENABLE_HOT_RELOAD)' == 'true'">
    <PropertyGroup>
      <OtherFlags>$(OtherFlags) --test:HotReloadDeltas</OtherFlags>
    </PropertyGroup>
  </Target>
</Project>
